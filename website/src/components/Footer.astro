---
// Footer component for landing page
---

<footer class="bg-bg-surface border-t border-border-default">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Logo & Description -->
      <div class="md:col-span-2">
        <div class="font-mono text-xl font-bold text-text-primary mb-3">
          <span class="text-accent-green">&gt;</span>kicode<span class="text-accent-blue">_</span>
        </div>
        <p class="text-text-secondary text-sm max-w-sm">
          An AI-powered coding assistant that runs in your terminal. Built with Rust for speed and reliability.
        </p>
      </div>

      <!-- Documentation -->
      <div>
        <h4 class="text-text-primary font-semibold mb-4">Documentation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/getting-started/installation" class="text-text-secondary hover:text-accent-blue transition-colors">Installation</a></li>
          <li><a href="/getting-started/configuration" class="text-text-secondary hover:text-accent-blue transition-colors">Configuration</a></li>
          <li><a href="/tools" class="text-text-secondary hover:text-accent-blue transition-colors">Tools Reference</a></li>
          <li><a href="/reference/models" class="text-text-secondary hover:text-accent-blue transition-colors">Supported Models</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-text-primary font-semibold mb-4">Resources</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/kishanhitk/kicode" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-blue transition-colors flex items-center gap-1">
              GitHub
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/kishanhitk/kicode/issues" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-blue transition-colors flex items-center gap-1">
              Report an Issue
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://openrouter.ai" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent-blue transition-colors flex items-center gap-1">
              OpenRouter API
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border-muted flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-text-muted text-xs">
        Built with Rust. Powered by AI.
      </p>
      <p class="text-text-muted text-xs">
        &copy; 2024 kicode. Open source under MIT license.
      </p>
    </div>
  </div>
</footer>
