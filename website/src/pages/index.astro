---
import Hero from "../components/Hero.astro";
import FeatureCard from "../components/FeatureCard.astro";
import InstallCommand from "../components/InstallCommand.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const features = [
  {
    icon: "models",
    title: "Multi-Model Support",
    description:
      "Access Claude, GPT-4, Grok, and more through OpenRouter. Switch models on the fly with a simple flag.",
  },
  {
    icon: "files",
    title: "Smart File Operations",
    description:
      "Read, write, and edit files with intelligent search-replace. Never lose context across your codebase.",
  },
  {
    icon: "shell",
    title: "Safe Shell Commands",
    description:
      "Execute commands with built-in safety analysis. Dangerous operations require explicit confirmation.",
  },
  {
    icon: "search",
    title: "Powerful Code Search",
    description:
      "Find anything with regex grep and glob patterns. Search across your entire project in milliseconds.",
  },
  {
    icon: "stream",
    title: "Streaming Responses",
    description:
      "Watch AI think in real-time with streaming output. No waiting for complete responses.",
  },
  {
    icon: "setup",
    title: "One-Command Setup",
    description:
      "Install in seconds with our install script. Interactive setup wizard configures everything.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="kicode - AI-powered coding assistant for your terminal. Built with Rust for speed and reliability."
    />
    <meta
      name="keywords"
      content="AI, coding assistant, terminal, CLI, Rust, developer tools"
    />

    <meta property="og:title" content="kicode - AI-Powered Coding Assistant" />
    <meta
      property="og:description"
      content="An AI coding assistant that runs in your terminal. Built with Rust for speed and reliability."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="kicode - AI-Powered Coding Assistant" />
    <meta
      name="twitter:description"
      content="An AI coding assistant that runs in your terminal."
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
      rel="stylesheet"
    />

    <title>kicode - AI-Powered Coding Assistant for Your Terminal</title>

    <style is:global>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-bg-primary text-text-primary min-h-screen">
    <!-- Hero Section -->
    <Hero>
      <InstallCommand slot="install-command" />
      <TerminalDemo slot="terminal-demo" />
    </Hero>

    <!-- Features Section -->
    <section class="py-32 px-4 border-t border-border-muted">
      <div class="max-w-6xl mx-auto">
        <div class="mb-20">
          <h2
            class="text-3xl md:text-5xl font-bold text-text-primary mb-6 tracking-tight"
          >
            Everything You Need.
          </h2>
          <p class="text-xl text-text-secondary max-w-2xl leading-relaxed">
            Built for developers who live in the terminal. Fast, secure, and
            powered by the best AI models.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12"
        >
          {features.map((feature) => <FeatureCard {...feature} />)}
        </div>
      </div>
    </section>

    <!-- How It Works Section - Simplified -->
    <section class="py-32 px-4 border-t border-border-muted">
      <div class="max-w-4xl mx-auto">
        <div class="mb-20">
          <h2
            class="text-3xl md:text-5xl font-bold text-text-primary mb-6 tracking-tight"
          >
            How It Works
          </h2>
        </div>

        <div class="space-y-16">
          <!-- Step 1 -->
          <div class="flex gap-8 items-start">
            <div
              class="flex-shrink-0 text-4xl font-mono font-bold text-text-muted opacity-30"
            >
              01
            </div>
            <div>
              <h3 class="text-2xl font-semibold text-text-primary mb-3">
                Install kicode
              </h3>
              <p class="text-text-secondary mb-4 text-lg">
                Run the install script or use Cargo. The setup wizard will help
                you configure your API key.
              </p>
              <code
                class="inline-block bg-bg-surface px-4 py-2 rounded text-sm font-mono text-text-primary border border-border-muted"
              >
                curl -fsSL https://kicode.kishans.in/install.sh | sh
              </code>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-8 items-start">
            <div
              class="flex-shrink-0 text-4xl font-mono font-bold text-text-muted opacity-30"
            >
              02
            </div>
            <div>
              <h3 class="text-2xl font-semibold text-text-primary mb-3">
                Start a session
              </h3>
              <p class="text-text-secondary mb-4 text-lg">
                Launch kicode in your project directory. It understands your
                codebase context automatically.
              </p>
              <code
                class="inline-block bg-bg-surface px-4 py-2 rounded text-sm font-mono text-text-primary border border-border-muted"
              >
                cd my-project && kicode
              </code>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-8 items-start">
            <div
              class="flex-shrink-0 text-4xl font-mono font-bold text-text-muted opacity-30"
            >
              03
            </div>
            <div>
              <h3 class="text-2xl font-semibold text-text-primary mb-3">
                Code with AI
              </h3>
              <p class="text-text-secondary text-lg">
                Describe what you want to build or fix. kicode reads, writes,
                and executes code on your behalf.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-4 border-t border-border-muted">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          class="text-3xl md:text-5xl font-bold text-text-primary mb-6 tracking-tight"
        >
          Ready to Code Smarter?
        </h2>
        <p
          class="text-xl text-text-secondary mb-12 max-w-xl mx-auto leading-relaxed"
        >
          Join developers who are shipping faster with AI assistance.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/getting-started/installation"
            class="inline-flex items-center justify-center px-8 py-3 bg-text-primary hover:bg-text-secondary text-bg-primary font-medium rounded-lg transition-colors"
          >
            Get Started
          </a>
          <a
            href="/tools"
            class="inline-flex items-center justify-center px-8 py-3 border border-border-default hover:bg-bg-surface text-text-primary font-medium rounded-lg transition-colors"
          >
            Explore Tools
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
